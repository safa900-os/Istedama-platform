# Local development. For a deployed environment these are set in the host's
# dashboard, never in a file — see DEPLOY.md and render.yaml.

NODE_ENV=development
PORT=5000

# Local Mongo. In production this is an Atlas connection string:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/istidamah?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/istidamah

# Development only. In production Render generates this and never prints it.
# Anyone holding this string can mint a valid admin token, so it must never be
# committed or reused between environments.
JWT_SECRET=change_this_super_secret_key
JWT_EXPIRES_IN=7d

# The one origin allowed to call this API. Not '*' in production: that lets any
# site on the internet make requests with a signed-in user's token.
CLIENT_ORIGIN=http://localhost:5173

# The seed's demo accounts have their passwords written in seed.js. It refuses
# to create them when NODE_ENV=production unless this is exactly "true".
ALLOW_DEMO_ACCOUNTS=false
